    },
    {
      "name": "tool.call.result",
      "wire": "{\"jsonrpc\":\"2.0\",\"id\":2,\"result\":{\"content\":[{\"type\":\"text\",\"text\":\"file.txt\"}]}}\n"
    },
    {
      "name": "error.forbidden",
